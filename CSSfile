/* تنظیمات عمومی */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

body {
    background-color: #0f172a;
    color: #f8fafc;
    line-height: 1.6;
}

/* هدر */
header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem 2rem;
    background-color: #1e293b;
    border-bottom: 1px solid #334155;
}

.logo {
    font-size: 1.5rem;
    font-weight: bold;
    color: #38bdf8;
}

.logo span {
    color: #f43f5e;
}

nav a {
    color: #cbd5e1;
    text-decoration: none;
    margin-right: 1.5rem;
    transition: color 0.3s;
}

nav a:hover {
    color: #38bdf8;
}

/* بخش‌ها */
.container {
    padding: 2rem;
    max-width: 1200px;
    margin: 0 auto;
}

h2 {
    margin-bottom: 0.5rem;
    color: #f1f5f9;
}

.subtitle {
    color: #94a3b8;
    font-size: 0.9rem;
    margin-bottom: 1.5rem;
}

/* اسکرول افقی کارت‌ها */
.horizontal-scroll {
    display: flex;
    gap: 1.5rem;
    overflow-x: auto;
    padding-bottom: 1rem;
    scroll-snap-type: x mandatory;
}

.horizontal-scroll::-webkit-scrollbar {
    height: 8px;
}

.horizontal-scroll::-webkit-scrollbar-thumb {
    background-color: #334155;
    border-radius: 4px;
}

/* استایل کارت خبر */
.card {
    flex: 0 0 300px;
    background-color: #1e293b;
    border-radius: 12px;
    padding: 1.2rem;
    border: 1px solid #334155;
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
}

.card tag {
    background-color: #0284c7;
    color: white;
    font-size: 0.75rem;
    padding: 0.2rem 0.6rem;
    border-radius: 20px;
    width: fit-content;
    margin-bottom: 0.8rem;
}

.card h3 {
    font-size: 1.1rem;
    margin-bottom: 0.8rem;
    color: #e2e8f0;
}

.card p {
    font-size: 0.88rem;
    color: #94a3b8;
    margin-bottom: 1rem;
}

/* شبکه‌بندی یوتیوب */
.grid-container {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
}

.video-card {
    background-color: #1e293b;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid #334155;
}

.video-card iframe {
    width: 100%;
    height: 180px;
    border: none;
}

.video-card h4 {
    padding: 1rem;
    font-size: 0.95rem;
}

footer {
    text-align: center;
    padding: 2rem;
    background-color: #0f172a;
    border-top: 1px solid #1e293b;
    color: #64748b;
    font-size: 0.85rem;
}
